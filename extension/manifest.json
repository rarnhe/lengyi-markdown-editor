{
  "manifest_version": 3,
  "name": "Lengyi Markdown - Web to MD",
  "version": "1.0.0",
  "description": "Capture static or browser-rendered article HTML directly from Chrome/Edge without a local proxy.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://rarnhe.github.io/*"
      ],
      "js": [
        "editor-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Lengyi Markdown: open markdown-editor.html and select Web to MD"
  },
  "minimum_chrome_version": "114"
}
